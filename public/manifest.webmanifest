{
  "name": "Digiteq Dashboard",
  "short_name": "Digiteq",
  "description": "Clients, tasks, team assignments and notes with live updates",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#f5f6fa",
  "theme_color": "#4f46e5",
  "categories": ["business", "productivity"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "My tasks", "url": "/#/tasks", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Notes", "url": "/#/notes", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
